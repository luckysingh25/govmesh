# Root Environment Configuration for GovMesh Docker Compose & Multi-Container Setup
POSTGRES_DB=govmesh
POSTGRES_USER=govmesh
POSTGRES_PASSWORD=replace-with-a-local-development-password
SECRET_KEY=replace-with-a-long-random-development-secret
DATABASE_URL="postgresql://user:password@localhost:5432/govmesh"
DATABASE_URL_UNPOOLED="postgresql://user:password@localhost:5432/govmesh"
REDIS_URL=redis://localhost:6379/0
