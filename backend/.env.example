APP_NAME=govmesh-backend
ENVIRONMENT=development
# ── Live Cloud Deployment (Render & Neon) ──────────────────────────────
# Live Frontend Web App:  https://govmesh-frontend.onrender.com/
# Live Backend API & Docs: https://govmesh-backend.onrender.com/docs
# Live Health Check:      https://govmesh-backend.onrender.com/health
# ───────────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/govmesh"
DATABASE_URL_UNPOOLED="postgresql://user:password@localhost:5432/govmesh"
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=replace-with-a-long-random-development-secret

# Department Service URLs
IDENTITY_URL=http://localhost:8101
MUNICIPALITY_URL=http://localhost:8102
PROPERTY_URL=http://localhost:8103
TAX_URL=http://localhost:8104
DEMO_CONTROLS_ENABLED=false
DEMO_CONTROL_KEY=
EXECUTION_PAYLOAD_LIMIT_BYTES=16384
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
WORKFLOW_EXECUTION_MODE=sync
